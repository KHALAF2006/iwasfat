{
  "name": "FoodItem",
  "type": "object",
  "properties": {
    "name_ar": {
      "type": "string",
      "description": "اسم الطعام بالعربية"
    },
    "name_en": {
      "type": "string",
      "description": "اسم الطعام بالإنجليزية"
    },
    "portion": {
      "type": "string",
      "description": "الكمية/الحصصة"
    },
    "portion_grams": {
      "type": "number",
      "description": "الوزن بالغرام"
    },
    "calories": {
      "type": "number",
      "description": "السعرات الحرارية"
    },
    "protein": {
      "type": "number",
      "description": "البروتين بالغرام"
    },
    "carbs": {
      "type": "number",
      "description": "الكربوهيدرات بالغرام"
    },
    "fat": {
      "type": "number",
      "description": "الدهون بالغرام"
    },
    "category": {
      "type": "string",
      "enum": [
        "grain",
        "protein",
        "dairy",
        "fruit",
        "vegetable",
        "fat",
        "beverage",
        "snack",
        "other",
        "bread_grain",
        "rice_main",
        "meat",
        "poultry",
        "fish_seafood",
        "legume",
        "salad",
        "soup",
        "egg_breakfast",
        "nuts_seeds",
        "oil_fat",
        "sweets",
        "fast_food",
        "condiment",
        "packaged_snack"
      ],
      "description": "الفئة"
    },
    "notes": {
      "type": "string",
      "description": "ملاحظات"
    },
    "external_id": {
      "type": "string",
      "description": "Stable slug from the reference generator (upsert key)"
    },
    "subcategory": {
      "type": "string",
      "description": "Subcategory slug"
    },
    "region": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regions where the dish is common"
    },
    "serving_desc_ar": {
      "type": "string",
      "description": "Serving description in Arabic"
    },
    "serving_desc_en": {
      "type": "string",
      "description": "Serving description in English"
    },
    "protein_g": {
      "type": "number",
      "description": "Protein grams per serving"
    },
    "carbs_g": {
      "type": "number",
      "description": "Carbs grams per serving"
    },
    "fat_g": {
      "type": "number",
      "description": "Fat grams per serving"
    },
    "fiber_g": {
      "type": "number",
      "description": "Fiber grams per serving"
    },
    "sugar_g": {
      "type": "number",
      "description": "Sugar grams per serving"
    },
    "sodium_mg": {
      "type": "number",
      "description": "Sodium milligrams per serving"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dietary tags incl. medical cautions"
    },
    "source_quality": {
      "type": "string",
      "enum": [
        "reference",
        "estimated"
      ],
      "description": "Data quality flag"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the item is active"
    }
  },
  "required": [
    "name_ar",
    "calories"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}